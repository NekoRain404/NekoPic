<component type="desktop-application">
  <id>io.github.nekopic.NekoPic</id>

  <name>NekoPic</name>
  <name xml:lang="zh_CN">NekoPic 照片编辑器</name>
  <summary>Simple photo editor for the Linux desktop</summary>
  <summary xml:lang="zh_CN">面向 Linux 桌面的轻量照片编辑器</summary>

  <description>
    <p>
      NekoPic is a desktop photo editor built with Qt Quick. It opens images
      through Qt's image plugins and keeps a single editing session with
      undo and redo around every committed operation.
    </p>
    <p>Editing tools include:</p>
    <ul>
      <li>Exposure, brightness, contrast, saturation and five adjustment tabs</li>
      <li>Built-in filter presets with an intensity control</li>
      <li>Crop, rotate, flip and image or canvas resizing</li>
      <li>Brush, text, shapes, mosaic and blur objects</li>
      <li>Recent files, clipboard output and format-aware export</li>
    </ul>
    <p>
      Read and write capabilities depend on the Qt image plugins available on
      the system. NekoPic keeps adjustments non-destructive until export, but
      saving always writes the merged image; there is no editable project
      format.
    </p>
  </description>

  <launchable type="desktop-id">nekopic.desktop</launchable>

  <provides>
    <binary>nekopic</binary>
  </provides>

  <categories>
    <category>Graphics</category>
    <category>Photography</category>
  </categories>

  <keywords>
    <keyword>photo</keyword>
    <keyword>image</keyword>
    <keyword>editor</keyword>
    <keyword>crop</keyword>
    <keyword>retouch</keyword>
  </keywords>

