#!/bin/sh
# AppRun template for the NekoPic AppDir.
#
# scripts/build-appimage.sh installs this file at the AppDir root. It sets up
# the paths used by linuxdeploy / linuxdeploy-plugin-qt (libraries, Qt plugins
# and QML modules) and then starts the application with the caller's arguments.
set -eu

APPDIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

lib_paths="$APPDIR/usr/lib"
for candidate in \
    "$APPDIR/usr/lib/x86_64-linux-gnu" \
    "$APPDIR/usr/lib/aarch64-linux-gnu"; do
    if [ -d "$candidate" ]; then
        lib_paths="$lib_paths:$candidate"
    fi
done

export PATH="$APPDIR/usr/bin:${PATH:-/usr/bin:/bin}"
export LD_LIBRARY_PATH="$lib_paths${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$APPDIR/usr/plugins${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
export QT_QPA_PLATFORM_PLUGIN_PATH="$APPDIR/usr/plugins/platforms"
export QML2_IMPORT_PATH="$APPDIR/usr/qml${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
export QML_IMPORT_PATH="$QML2_IMPORT_PATH"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

exec "$APPDIR/usr/bin/nekopic" "$@"
